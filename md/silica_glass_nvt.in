# SiO2 glass NVT production MD (LAMMPS + Vashishta SiO2)
# Continues an already-quenched glass replica (e.g. one of DM2's
# sio2_3000_glass_*_sample*.dat structures) at FIXED volume, so every dumped
# frame shares exactly one cell and the same corner-sharing SiO4 topology
# (no bond exchange). That is what test40's fixed-topology CG mapping and
# `prepare` need for multi-frame training: unlike separately-quenched glass
# replicas (different random networks, different cells), the frames dumped
# here are decorrelated-in-time snapshots of the SAME tracked atoms, so a
# single Si-O connectivity table and per-frame cell length both stay valid
# across the whole trajectory. One replica per invocation; expects SEED and
# REPLICA passed via -var. Output goes to md/glass_traj_${REPLICA}.lammpstrj.
#
# IMPORTANT: DM2's glass data files list atom type 1 = O (15.9994) and
# type 2 = Si (28.0855) -- the REVERSE of md/silica_beta_cristobalite_init.data
# (type 1 = Si, type 2 = O). The pair_coeff element order below ("O Si") must
# match that reversed type order, or the potential is silently misassigned.
#
# Usage:
#   lmp -in md/silica_glass_nvt.in \
#       -var TEMP 300 -var NSTEPS 2000000 -var DUMP_EVERY 200 \
#       -var SEED 42 -var REPLICA 0 \
#       -var INIT_DATA md/glass_seed.dat
#
# Defaults: 2,000,000 steps × 1 fs = 2 ns, dump every 200 fs → 10,000 frames.
# INIT_DATA defaults to md/glass_seed.dat, a single already-quenched
# reference structure bundled with this repo (DM2, see licenses/DM2-MIT.txt
# and the "同梱参照の出典" section of README.md); every replica restarts
# NVT dynamics from that same structure with a different velocity seed.

variable        TEMP       index 300
variable        NSTEPS     index 2000000
variable        DUMP_EVERY index 200
variable        EQ_STEPS   index 20000
variable        SEED       index 42
variable        REPLICA    index 0
variable        INIT_DATA  index md/glass_seed.dat

units           metal
boundary        p p p
atom_style      charge

read_data       ${INIT_DATA}

variable        POT getenv LAMMPS_POTENTIALS
pair_style      vashishta
pair_coeff      * * ${POT}/SiO.1990.vashishta O Si

velocity        all create ${TEMP} ${SEED} mom yes rot yes dist gaussian

timestep        0.001                       # 1 fs (metal units → ps)

# NVT equilibration
fix             eqnvt all nvt temp ${TEMP} ${TEMP} 0.1
run             ${EQ_STEPS}
unfix           eqnvt

# NVT production at FIXED cell: no barostat, so every dumped frame shares
# exactly the same box. (The crystal script uses NPT "cell breathing"; that
# is fine there because test40 now stores a cell length per frame, but a
# glass network's connectivity cannot survive being pooled across separately
# quenched replicas, so this script instead holds volume fixed and relies on
# a single long trajectory for decorrelated frames.)
fix             prodnvt all nvt temp ${TEMP} ${TEMP} 0.1

thermo          5000
thermo_style    custom step temp press vol pe density

dump            traj all custom ${DUMP_EVERY} md/glass_traj_${REPLICA}.lammpstrj &
                id type xu yu zu
dump_modify     traj sort id append no format float %.6f

run             ${NSTEPS}
